# Server Binding
HOST=0.0.0.0
PORT=8080

# SQLite Thread Memory
SQLITE_PATH=chatni.db
MAX_THREAD_MESSAGES=30

# Bot Persona
BOT_NAME=gemini
MAX_TOOL_ITERATIONS=10

# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-pro
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# GitHub Personal Access Token (Fine-Grained PAT or Classic PAT with repo/pull_requests access)
# Used by both the GitHub MCP server and the built-in GitHub fallback tools
GITHUB_TOKEN=ghp_your_github_personal_access_token

# GitHub MCP Configuration
# By default, Chatni loads `mcp.json` (which points to GitHub's official remote MCP server
# https://api.githubcopilot.com/mcp/ authenticated with GITHUB_TOKEN).
# You can also override with a local stdio MCP server command:
# GITHUB_MCP_COMMAND=github-mcp-server stdio
# Or npx:
# GITHUB_MCP_COMMAND=npx -y @modelcontextprotocol/server-github
MCP_CONFIG_PATH=mcp.json

# Optional Google Chat Security & Async Replies
# GOOGLE_CHAT_VERIFICATION_TOKEN=your_verification_token
# Path to a Google Cloud Service Account JSON file (or raw JSON) with `chat.bot` scope for async follow-up messages:
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
# Or a Google Chat Space Incoming Webhook URL:
# GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/AAA/messages?key=...&token=...
